PORT=3000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=matista_dev
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# Mínimo 4 en development/test; production exige al menos 10. Máximo 72 bytes UTF-8.
PASSWORD_MIN_LENGTH=4
# Secreto aleatorio de al menos 32 bytes, codificado como base64url sin relleno.
JWT_SECRET=
JWT_ISSUER=matista-backend
JWT_AUDIENCE=matista-frontend
# Parámetros centralizados en security/config.js: bcrypt 12; JWT 7200 s;
# verificación 86400 s; recuperación 1800 s.

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
